POSTGRES_DB=rdms
POSTGRES_USER=rdms
POSTGRES_PASSWORD=change-me-for-local-use
DATABASE_URL=postgresql+psycopg://rdms:change-me-for-local-use@db:5432/rdms
APP_TIMEZONE=Asia/Shanghai
UPLOAD_ROOT=/data/uploads
UPLOAD_HOST_ROOT=./data/uploads
MAX_UPLOAD_BYTES=104857600
APP_HOST_PORT=8080
LOG_LEVEL=INFO
# 可选；仅在点击“查询公开资料”时调用 CAS Common Chemistry
CAS_COMMON_CHEMISTRY_API_KEY=

# 本机 HTTP 使用 false；未来 HTTPS 部署必须设为 true
AUTH_COOKIE_SECURE=false
